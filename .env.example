# Discord Webhook URL
# Discordサーバーの設定からWebhook URLを取得して設定してください
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN"

# 手動実行用シークレットキー
# 十分に長くて推測困難な文字列を設定してください
MANUAL_TRIGGER_SECRET_KEY="your-strong-secret-key-for-manual-trigger"

# 暗号化用シークレットキー
# 先頭の32文字だけを鍵に使います。32文字以上の推測困難な文字列を設定してください
# ENCRYPTION_SECRET_KEYの環境変数なしでnpm run encryptを実行すると、新しい鍵を表示します
ENCRYPTION_SECRET_KEY="your-strong-encryption-key-32-chars-long"

# Cloudflare API Token
# https://dash.cloudflare.com/profile/api-tokens で作成
# 権限: Workers スクリプト - Edit, アカウント設定 - Read
CLOUDFLARE_API_TOKEN="your-cloudflare-api-token-here"

# Cloudflare Account ID
# Cloudflareダッシュボードのホームページで確認できます
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id-here"

# Worker URL (本番テスト用)
# デプロイ後のWorker URL: https://daily-reminder.[your-subdomain].workers.dev
# 最初のデプロイの後に設定してください。空でない値はGitHub Actionsのヘルスチェックの送り先になります
WORKER_URL=""